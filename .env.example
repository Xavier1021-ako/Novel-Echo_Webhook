# Copy this file to .env locally. Never commit your real .env file.
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_client_id
# Optional: use a test server ID for instant guild command updates.
DISCORD_GUILD_ID=
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
BOT_NAME=Novax
# Optional: customize Novax's behavior.
SYSTEM_PROMPT=You are Novax, a helpful, witty, friendly Discord AI assistant. Be concise, respectful, and useful.
